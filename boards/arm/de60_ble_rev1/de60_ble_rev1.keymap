#include "../common.keymap"

#define WIN 0
#define WIN_FN 1
#define MAC 2
#define MAC_FN 3

/ {
    behaviors {
        win_logout: win_logout {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Win Logout";
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp L>, <&macro_release &kp LGUI>;
        };

        win_login: win_login {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Win Login";
            bindings = <&macro_press &kp LCTRL &kp LALT>, <&macro_tap &kp DEL>, <&macro_release &kp LCTRL &kp LALT>;
        };

        pass91: pass91 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Pass91";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_press &kp LSHFT>, <&macro_tap &kp H>, <&macro_release &kp LSHFT>, <&macro_tap &kp A &kp I &kp K &kp Y &kp N9 &kp N1 &kp N &kp A &kp EXCL>;
        };

        pass90: pass90 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Pass90";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_press &kp LSHFT>, <&macro_tap &kp H>, <&macro_release &kp LSHFT>, <&macro_tap &kp A &kp I &kp K &kp Y &kp N9 &kp N9 &kp N0 &kp N &kp A &kp EXCL>;
        };

        corp_domain: corp_domain {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Corp Domain";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp C &kp O &kp R &kp P &kp BSLH &kp K &kp Y &kp N9 &kp N1 &kp DOT &kp H &kp A &kp I>;
        };

        domain_name: domain_name {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Domain Name";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp K &kp Y &kp N9 &kp N1 &kp DOT &kp H &kp A &kp I>;
        };

        gen_id: gen_id {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "GenID";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp N1 &kp N5 &kp N7 &kp N9 &kp N8 &kp N6 &kp N7 &kp N5>;
        };

        name_vn: name_vn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Name (Windows Unicode)";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press &kp LSHFT>, <&macro_tap &kp N>, <&macro_release &kp LSHFT>,
                <&macro_tap &kp G &kp U &kp Y>,
                <&macro_press &kp LALT>, <&macro_tap &kp KP_PLUS &kp N1 &kp E &kp C &kp N5>, <&macro_release &kp LALT>,
                <&macro_tap &kp N &kp SPACE>,
                <&macro_press &kp LSHFT>, <&macro_tap &kp H>, <&macro_release &kp LSHFT>,
                <&macro_tap &kp A>,
                <&macro_press &kp LALT>, <&macro_tap &kp KP_PLUS &kp N1 &kp E &kp A &kp N3>, <&macro_release &kp LALT>,
                <&macro_tap &kp I &kp SPACE>,
                <&macro_press &kp LSHFT>, <&macro_tap &kp K>, <&macro_release &kp LSHFT>,
                <&macro_press &kp LALT>, <&macro_tap &kp KP_PLUS &kp N1 &kp E &kp F &kp N7>, <&macro_release &kp LALT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Win";
            bindings = <
&gresc     &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSLH  &kp DEL
&kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSPC
&kp CAPS   &kp A     &kp S     &kp D     &kp F     &kp G     &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT             &kp ENTER
&kp LSHFT  &kp NUBS  &kp Z     &kp X     &kp C     &kp V     &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &none     &lt WIN_FN RSHFT
&kp LCTRL  &kp LGUI  &kp LALT                                &kp SPACE                     &kp RALT  &win_login  &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        win_function_layer {
            label = "Win Function";
            bindings = <
&kp GRAVE &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12   &DE_BLD    &trans
&DE_USB   &DE_BT1   &DE_BT2   &DE_BT3   &none     &none     &none     &none     &none     &none     &none     &UGSPD    &UGSPI    &gen_id
&DE_BAT   &none     &none     &DE_OZW   &none     &none     &none     &none     &none     &none     &UGHUD    &UGHUI              &name_vn
&DE_SLP   &domain_name &none  &none     &none     &none     &none     &none     &none     &UGSAD    &UGSAI    &win_logout &UGBRI &trans
&DE_OUT   &pass91   &pass90                                  &none                         &none     &corp_domain &UGEFR &UGBRD &UGEFF
            >;
        };

        mac_layer {
            label = "Mac";
            bindings = <
&gresc     &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSLH  &kp DEL
&kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSPC
&kp CAPS   &kp A     &kp S     &kp D     &kp F     &kp G     &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT             &kp ENTER
&kp LSHFT  &kp NUBS  &kp Z     &kp X     &kp C     &kp V     &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp UP    &lt MAC_FN RSHFT
&kp LCTRL  &kp LALT  &kp LGUI                                &kp SPACE                     &kp RALT  &mo MAC_FN   &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        mac_function_layer {
            label = "Mac Function";
            bindings = <
&kp GRAVE &kp C_BRI_DN &kp C_BRI_UP &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS &kp C_AC_DESKTOP_SHOW_ALL_APPLICATIONS &kp C_AC_SEARCH &kp GLOBE &kp C_PREV &kp C_PP &kp C_NEXT &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &DE_BLD &trans
&DE_USB   &DE_BT1   &DE_BT2   &DE_BT3   &none     &none     &none     &none     &none     &none     &none     &UGSPD    &UGSPI    &none
&DE_BAT   &none     &none     &DE_OZW   &none     &none     &none     &none     &none     &none     &UGHUD    &UGHUI              &UGTOG
&DE_SLP   &none     &none     &none     &none     &none     &none     &none     &none     &UGSAD    &UGSAI    &none     &UGBRI    &trans
&DE_OUT   &to WIN   &none                                   &none                         &none     &none     &UGEFR    &UGBRD    &UGEFF
            >;
        };

        layer_4 { status = "reserved"; };
        layer_5 { status = "reserved"; };

    };
};
